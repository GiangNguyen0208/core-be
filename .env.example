# ============================================================
# be-core/.env.example — MẪU cho CHẠY NATIVE (local development)
# ============================================================
# Cách dùng:
#     copy .env.example .env
# rồi chỉnh các giá trị cần thiết.
#
# File `.env` đã được gitignore + dockerignore, KHÔNG commit.
#
# LƯU Ý: Docker KHÔNG dùng file này. Khi chạy bằng docker compose, cấu hình
# lấy từ `runtime.env.example` (bắt buộc) + `runtime.env` (tuỳ chọn).
# ============================================================

# --- Database -------------------------------------------------
# Postgres chạy bằng Docker (`docker compose up -d db`), publish ra localhost.
DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/social_auto

# --- Thư mục lưu video ----------------------------------------
# Bỏ trống => mặc định `<gốc repo>/downloads`.
# DOWNLOAD_DIR=

# --- Vai trò tiến trình ---------------------------------------
# Giá trị dưới đây dành cho tiến trình API. Tiến trình worker phải override
# 2 biến này lúc chạy (xem README), vì load_dotenv không ghi đè biến đã có
# sẵn trong môi trường.
APP_ROLE=api
SCHEDULER_ENABLED=false
BACKGROUND_JOBS_MODE=dedicated-worker
LOG_LEVEL=DEBUG

# --- Tài khoản quản trị ---------------------------------------
ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_DISPLAY_NAME=Quản trị viên
PASSWORD_MIN_LENGTH=8
AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Bảo mật --------------------------------------------------
# BẮT BUỘC đổi trước khi lên production.
JWT_SECRET=change-me-jwt-secret
TOKEN_ENCRYPTION_SECRET=change-me-token-secret

# --- CORS -----------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Địa chỉ công khai ----------------------------------------
BASE_URL=http://localhost:8000

# --- Facebook / AI --------------------------------------------
FB_VERIFY_TOKEN=dev-verify-token
FB_APP_SECRET=
GEMINI_API_KEY=

# --- Task queue / scheduler -----------------------------------
SCHEDULER_INTERVAL_MINUTES=1
TASK_QUEUE_POLL_SECONDS=5
TASK_RETRY_BASE_SECONDS=15
TASK_RETRY_MAX_SECONDS=300
TASK_LOCK_STALE_SECONDS=300
WORKER_STALE_SECONDS=30
WORKER_BATCH_SIZE=3

# --- HTTP client ----------------------------------------------
EXTERNAL_HTTP_TIMEOUT=10
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_SECONDS=2
HTTP_RETRY_MAX_SECONDS=20

# --- Schema ---------------------------------------------------
AUTO_CREATE_SCHEMA=false
